-- Umoor Marafiq Burhaniyah (UMB) module: per-person document storage.
-- Additive only: no existing table or row is modified.
-- Access follows public.user_roles: any signed-in user with a role can read,
-- editors/admins can upload, admins can delete.

-- 1. Document types (Aadhar, PAN, MBI, ...). is_required drives the completeness checks.
create table if not exists public.umb_document_types (
  id bigint generated by default as identity primary key,
  name text not null unique check (length(trim(name)) between 1 and 80),
  is_required boolean not null default false,
  sort_order integer not null default 0,
  created_at timestamptz not null default now()
);

insert into public.umb_document_types (name, is_required, sort_order) values
  ('Aadhar Card', true, 1),
  ('PAN Card', true, 2),
  ('MBI', true, 3),
  ('Other', false, 99)
on conflict (name) do nothing;

-- 2. Documents, one row per uploaded file, linked to the person's mumin_data row.
create table if not exists public.umb_documents (
  id uuid primary key default gen_random_uuid(),
  mumin_id bigint not null references public.mumin_data(id) on delete cascade,
  document_type_id bigint not null references public.umb_document_types(id) on delete restrict,
  file_name text not null,
  storage_path text not null unique,
  mime_type text,
  size_bytes bigint check (size_bytes is null or size_bytes >= 0),
  notes text not null default '',
  uploaded_by text,
  created_at timestamptz not null default now()
);

create index if not exists umb_documents_mumin_idx on public.umb_documents (mumin_id);
create index if not exists umb_documents_type_idx on public.umb_documents (document_type_id);

-- 3. Row level security
alter table public.umb_document_types enable row level security;
alter table public.umb_documents enable row level security;

do $$
declare tbl text;
begin
  foreach tbl in array array['umb_document_types','umb_documents'] loop
    execute format('drop policy if exists %I on public.%I', tbl || '_select_roles', tbl);
    execute format('create policy %I on public.%I for select to authenticated using (exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid())))', tbl || '_select_roles', tbl);
    execute format('drop policy if exists %I on public.%I', tbl || '_insert_editors', tbl);
    execute format('create policy %I on public.%I for insert to authenticated with check (exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid()) and ur.role in (''admin'',''editor'')))', tbl || '_insert_editors', tbl);
    execute format('drop policy if exists %I on public.%I', tbl || '_update_editors', tbl);
    execute format('create policy %I on public.%I for update to authenticated using (exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid()) and ur.role in (''admin'',''editor''))) with check (exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid()) and ur.role in (''admin'',''editor'')))', tbl || '_update_editors', tbl);
    execute format('drop policy if exists %I on public.%I', tbl || '_delete_admins', tbl);
    execute format('create policy %I on public.%I for delete to authenticated using (exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid()) and ur.role = ''admin''))', tbl || '_delete_admins', tbl);
    execute format('grant select, insert, update, delete on public.%I to authenticated', tbl);
  end loop;
end $$;

-- 4. Private storage bucket for the files themselves (signed URLs only).
insert into storage.buckets (id, name, public)
values ('umb-documents', 'umb-documents', false)
on conflict (id) do update set public = false;

drop policy if exists "umb-documents: roles can read" on storage.objects;
create policy "umb-documents: roles can read"
on storage.objects for select to authenticated
using (
  bucket_id = 'umb-documents'
  and exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid()))
);

drop policy if exists "umb-documents: editors can upload" on storage.objects;
create policy "umb-documents: editors can upload"
on storage.objects for insert to authenticated
with check (
  bucket_id = 'umb-documents'
  and exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid()) and ur.role in ('admin','editor'))
);

drop policy if exists "umb-documents: admins can delete" on storage.objects;
create policy "umb-documents: admins can delete"
on storage.objects for delete to authenticated
using (
  bucket_id = 'umb-documents'
  and exists (select 1 from public.user_roles ur where ur.user_id = (select auth.uid()) and ur.role = 'admin')
);
